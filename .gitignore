.venv/
.venv-gpu/
.venv-wsl/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Generated scientific data can become very large.
data/generated/
outputs/
tmp/
*.npy
*.npz
*.pt
*.h5
*.hdf5
*.zarr/
artifacts/experiment/*-dry-run*/

# Formal-run caches contain per-case binary payloads and sidecar hashes.  The
# curated manifests/results are committed explicitly; these local stores are not.
artifacts/experiment/*/data/.generator_case_cache/
artifacts/experiment/*/data/.sealed_generator_store/

# Private formal-run audit streams retain machine-local paths and detailed
# training traces.  Publish only the curated, checksum-authenticated evidence.
artifacts/experiment/*/access_audit.jsonl
artifacts/experiment/*/generation_progress.jsonl
artifacts/experiment/*/analysis/analysis_access_state.json
artifacts/experiment/*/checkpoints/checkpoint_manifest.json
artifacts/experiment/*/checkpoints/training_progress.jsonl
artifacts/experiment/*/checkpoints/training_worker_audit.json
artifacts/experiment/*/checkpoints/training_worker_contract.json

# Local IDE and operating-system files.
.vscode/
.idea/
.DS_Store
Thumbs.db
