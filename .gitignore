.venv/
.venv-gpu/
.venv-wsl/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Generated scientific data can become very large.
data/generated/
outputs/
tmp/
*.npy
*.npz
*.pt
*.h5
*.hdf5
*.zarr/
artifacts/experiment/*-dry-run*/

# Formal-run caches contain per-case binary payloads and sidecar hashes.  The
# curated manifests/results are committed explicitly; these local stores are not.
artifacts/experiment/*/data/.generator_case_cache/
artifacts/experiment/*/data/.sealed_generator_store/

# Local IDE and operating-system files.
.vscode/
.idea/
.DS_Store
Thumbs.db
